# Sample configuration values for the Skier Lift Ride System.
# Copy this file to `.env` and adjust the values before sourcing it.

# --- Local development ----------------------------------------------------
CLIENT1_BASEURL=http://localhost:8080/Server_war_exploded
CLIENT2_BASEURL=http://localhost:8080/Server2_war
CLIENT2_RATE_LIMIT=2000
CLIENT2_FAILURE_THRESHOLD=50
CLIENT2_CIRCUIT_BREAKER_TIMEOUT_MS=10000
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
REDIS_URI=redis://localhost:6379
QUEUE_NAME=SkierServletPostQueue

# --- Staging --------------------------------------------------------------
# CLIENT1_BASEURL=https://staging.example.com/Server_war
# CLIENT2_BASEURL=https://staging.example.com/Server2_war
# CLIENT2_RATE_LIMIT=4000
# CLIENT2_FAILURE_THRESHOLD=75
# CLIENT2_CIRCUIT_BREAKER_TIMEOUT_MS=15000
# RABBITMQ_HOST=staging-rabbitmq.internal
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=staging_user
# RABBITMQ_PASSWORD=staging_secret
# REDIS_URI=redis://staging-redis.internal:6379
# QUEUE_NAME=SkierServletPostQueue

# --- Production -----------------------------------------------------------
# CLIENT1_BASEURL=https://api.example.com/Server_war
# CLIENT2_BASEURL=https://api.example.com/Server2_war
# CLIENT2_RATE_LIMIT=6000
# CLIENT2_FAILURE_THRESHOLD=100
# CLIENT2_CIRCUIT_BREAKER_TIMEOUT_MS=20000
# RABBITMQ_HOST=prod-rabbitmq.internal
# RABBITMQ_PORT=5671
# RABBITMQ_USERNAME=prod_user
# RABBITMQ_PASSWORD=prod_secret
# REDIS_URI=redis://prod-redis.internal:6379
# QUEUE_NAME=SkierServletPostQueue
